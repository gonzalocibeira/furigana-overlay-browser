{
  "manifest_version": 3,
  "name": "Kō — Japanese Reading Companion",
  "short_name": "Kō",
  "version": "1.0.0",
  "description": "Automatic offline furigana overlays for webpages and Google Docs.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "options_ui": {
    "page": "about.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-unavailable-16.png",
      "32": "icons/icon-unavailable-32.png",
      "48": "icons/icon-unavailable-48.png",
      "128": "icons/icon-unavailable-128.png"
    },
    "default_title": "Kō \u2014 checking this page"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "docs-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "minimum_chrome_version": "116",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://en.wiktionary.org https://ja.wiktionary.org; worker-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
